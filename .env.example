# local: sideload a development manifest and let Microsoft's helper create the
# task-pane-enabled DOCX. deployed: open an existing auto-open DOCX.
WORD_E2E_MODE=local

# URL used to identify the task-pane WebView2 target.
WORD_E2E_TASKPANE_URL=https://localhost:3000/taskpane.html

# Optional CSS selector that marks the application as ready.
WORD_E2E_READY_SELECTOR=[data-testid="app-ready"]

# Optional diagnostics and lifecycle controls.
WORD_E2E_CDP_PORT=9222
WORD_E2E_LOG_LEVEL=debug
WORD_E2E_KEEP_OPEN=0
WORD_E2E_KEEP_ARTIFACTS=0

# Local-mode settings.
WORD_E2E_MANIFEST_PATH=../path-to-addin/manifest.xml
WORD_E2E_DEV_SERVER_COMMAND=npm run dev
WORD_E2E_DEV_SERVER_CWD=../path-to-addin
WORD_E2E_DEV_SERVER_URL=https://localhost:3000/taskpane.html
WORD_E2E_DEV_SERVER_PORT=3000
WORD_E2E_IGNORE_HTTPS_ERRORS=1
# Optional only when your package manager does not expose the installed CLI.
# WORD_E2E_OFFICE_DEBUGGING_CLI=./node_modules/office-addin-debugging/cli.js

# Deployed-mode settings. Leave these unset in local mode.
# WORD_E2E_DOCUMENT_PATH=C:\path\to\auto-open-test-document.docx
# WORD_E2E_WORD_EXE=C:\Program Files\Microsoft Office\Root\Office16\WINWORD.EXE
