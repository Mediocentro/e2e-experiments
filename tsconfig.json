{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"],
    "skipLibCheck": true
  },
  "include": [
    "global-setup.ts",
    "global-teardown.ts",
    "playwright.config.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
